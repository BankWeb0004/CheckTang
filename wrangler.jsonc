{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checktang",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.js",
  "build": {
    "command": "npm run build",
    "cwd": "."
  },
  "pages_build_output_dir": "dist/client"
}
